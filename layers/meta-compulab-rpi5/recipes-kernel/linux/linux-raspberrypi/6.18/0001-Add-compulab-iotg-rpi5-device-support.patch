index 000000000000..93547431f924
--- /dev/null
+++ b/arch/arm/boot/dts/overlays/iotg-rpi5/iotg-rpi5-modem-reset-overlay.dts
@@ -0,0 +1,45 @@
+// Definitions for IOTG-RPI5 Board to Board Connector 
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	compatible = "brcm,bcm2712";
+
+	fragment@0 {
+		target = <&gpio>;
+		__overlay__ {
+			modem_rst_pinctrl: modem-rst-pinctrl {
+				pins = "gpio7";
+				function = "gpio";
+				bias-disable;
+			};
+		};
+	};
+
+	fragment@1 {
+		target-path = "/";
+		__overlay__ {
+			modem_rst_ctrl: modem-rst-ctrl {
+				pinctrl-names = "default";
+				pinctrl-0 = <&modem_rst_pinctrl>;
+				compatible = "gpio-leds";
+				status = "okay";
+
+				modem_rst: modem-rst {
+					label = "MODEM_RST";
+					gpios = <&gpio 7 GPIO_ACTIVE_HIGH>;
+					linux,default-trigger = "oneshot";
+					led-pattern = <300 300>;
+				};
+			};
+		};
+	};
+
+	__overrides__ {
+		active_low = <&modem_rst>,"gpios:8";
+		delay_ms = <&modem_rst>,"led-pattern:0",<&modem_rst>,"led-pattern:4";
+	};
+};
