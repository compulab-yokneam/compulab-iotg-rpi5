@@ -0,0 +1,64 @@
+// Definitions for IOTG-RPI5 I/O Part A
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	compatible = "brcm,bcm2712";
+
+	/* RS485 B */
+	fragment@0 {
+		target = <&rs485_b>;
+		__dormant__ {
+			status = "okay";
+		};
+	};
+	/* SEL B: RS485 */
+	fragment@1 {
+		target = <&sel_b>;
+		__dormant__ {
+			output-high;
+			line-name = "SEL_B_RS485";
+			status = "okay";
+		};
+	};
+
+	/* CAN B */
+	fragment@2 {
+		target = <&can_b_irq>;
+		__dormant__ {
+			status = "okay";
+		};
+	};
+	fragment@3 {
+		target = <&spi0>;
+		__dormant__ {
+			status = "okay";
+		};
+	};
+	/* SEL B: CAN */
+	fragment@4 {
+		target = <&sel_b>;
+		__dormant__ {
+			output-low;
+			line-name = "SEL_B_CAN";
+			status = "okay";
+		};
+	};
+
+	/* 5V_EN_ISO1 Regulator */
+	fragment@5 {
+		target = <&reg_en_5v_iso1>;
+		__dormant__ {
+			enable-active-high;
+		};
+	};
+
+	__overrides__ {
+		rs485 = <0>, "+0+1+5";
+		can   = <0>, "+2+3+4+5";
+	};
+};
diff --git a/arch/arm/boot/dts/overlays/iotg-rpi5/iotg-rpi5-modem-reset-overlay.dts b/arch/arm/boot/dts/overlays/iotg-rpi5/iotg-rpi5-modem-reset-overlay.dts
