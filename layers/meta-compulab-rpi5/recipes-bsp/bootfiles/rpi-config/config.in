dtparam=audio=on
camera_auto_detect=1
display_auto_detect=1
auto_initramfs=1
dtoverlay=vc4-kms-v3d
max_framebuffers=2
disable_fw_kms_setup=1
arm_64bit=1
disable_overscan=1
arm_boost=1

[cm4]
otg_mode=1

[cm5]
dtoverlay=dwc2,dr_mode=host
dtparam=uart0=on

[all]
device_tree=iotg-rpi5.dtb
dtoverlay=iotg-rpi5/iotg-rpi5-dio

[cm5l]
device_tree=iotg-rpi5l.dtb
